
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="CFC JF - Centro de Formação de Condutores em Campo Mourão, Paraná. Entre em contato para informações sobre habilitação.">

  <title>CFC JF | Auto Escola em Campo Mourão</title>

  <style>
    :root {
      --azul: #102746;
      --azul-claro: #1769aa;
      --amarelo: #ffc928;
      --branco: #ffffff;
      --cinza: #f3f6fa;
      --texto: #293548;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--texto);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    .topo {
      background: var(--azul);
      color: white;
      padding: 10px 7%;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      font-size: 14px;
    }

    header {
      background: white;
      padding: 18px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 3px 15px #00000012;
    }

    .logo {
      color: var(--azul);
      font-size: 25px;
      font-weight: 900;
      line-height: 1.1;
    }

    .logo span {
      color: var(--azul-claro);
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
    }

    nav a {
      color: var(--azul);
      font-weight: bold;
    }

    nav a:hover {
      color: var(--azul-claro);
    }

    .hero {
      min-height: 570px;
      padding: 90px 7%;
      display: flex;
      align-items: center;
      color: white;
      background:
        linear-gradient(90deg, #102746f5, #102746a8),
        url("https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?auto=format&fit=crop&w=1800&q=85")
        center/cover;
    }

    .hero-conteudo {
      max-width: 760px;
    }

    .etiqueta {
      color: var(--amarelo);
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    h1 {
      font-size: clamp(38px, 6vw, 65px);
      line-height: 1.1;
      margin: 20px 0;
    }

    .hero p {
      font-size: 19px;
      max-width: 620px;
      color: #e8eef6;
    }

    .botoes {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .botao {
      display: inline-block;
      padding: 14px 23px;
      border-radius: 7px;
      font-weight: bold;
      transition: .2s;
    }

    .botao:hover {
      transform: translateY(-2px);
    }

    .botao-amarelo {
      background: var(--amarelo);
      color: var(--azul);
    }

    .botao-branco {
      background: white;
      color: var(--azul);
    }

    section {
      padding: 75px 7%;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    .subtitulo {
      color: var(--azul-claro);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 13px;
      font-weight: bold;
    }

    h2 {
      color: var(--azul);
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.2;
      margin: 12px 0 18px;
    }

    .descricao {
      max-width: 720px;
      color: #687386;
    }

    .servicos {
      background: var(--cinza);
    }

    .grade {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      margin-top: 35px;
    }

    .cartao {
      padding: 28px;
      background: white;
      border-radius: 13px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 8px 25px #1027460a;
    }

    .icone {
      font-size: 37px;
    }

    .cartao h3 {
      color: var(--azul);
      margin: 15px 0 10px;
    }

    .sobre-grade {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 45px;
    }

    .foto {
      min-height: 350px;
      border-radius: 16px;
      background:
        url("https://images.unsplash.com/photo-1489824904134-891ab64532f1?auto=format&fit=crop&w=1200&q=85")
        center/cover;
    }

    .lista {
      list-style: none;
      margin: 22px 0;
    }

    .lista li {
      margin: 12px 0;
    }

    .lista li::before {
      content: "✓";
      color: #16834a;
      font-weight: bold;
      margin-right: 12px;
    }

    .chamada {
      background: var(--azul);
      color: white;
      text-align: center;
    }

    .chamada h2 {
      color: white;
    }

    .chamada p {
      max-width: 650px;
      margin: auto;
      color: #dce7f4;
    }

    .chamada .botoes {
      justify-content: center;
    }

    .contatos {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      margin-top: 28px;
    }

    .contato {
      background: var(--cinza);
      padding: 25px;
      border-radius: 12px;
      overflow-wrap: anywhere;
    }

    .contato h3 {
      color: var(--azul);
      margin-bottom: 10px;
    }

    .contato a {
      color: var(--azul-claro);
      font-weight: bold;
    }

    footer {
      background: #09182b;
      color: #dbe4ef;
      padding: 30px 7%;
      text-align: center;
      font-size: 14px;
    }

    .whatsapp {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 20;
      background: #20bd5a;
      color: white;
      padding: 14px 20px;
      border-radius: 50px;
      font-weight: bold;
      box-shadow: 0 5px 20px #0003;
    }

    @media (max-width: 800px) {
      header {
        flex-direction: column;
        align-items: flex-start;
      }

      nav {
        gap: 12px;
      }

      .hero {
        min-height: 480px;
        padding: 65px 7%;
      }

      .grade {
        grid-template-columns: 1fr;
      }

      .sobre-grade,
      .contatos {
        grid-template-columns: 1fr;
      }

      .foto {
        min-height: 250px;
      }

      .topo {
        justify-content: center;
        text-align: center;
      }
    }
  </style>
</head>

<body>

  <div class="topo">
    <span>📍 Campo Mourão - Paraná</span>
    <span>📞 (44) 3523-3709</span>
  </div>

  <header>
    <a href="#inicio" class="logo">
      CFC <span>JF</span><br>
