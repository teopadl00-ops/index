
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CFC JF | Sua Habilitação Começa Aqui</title>
  <meta name="description" content="CFC JF - Centro de Formação de Condutores em Campo Mourão. Conheça nossos serviços e entre em contato.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --azul: #071d3b;
      --azul2: #103563;
      --amarelo: #ffcc22;
      --branco: #ffffff;
      --cinza: #f4f6fa;
      --texto: #243247;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      color: var(--texto);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    .topo {
      background: var(--azul);
      color: white;
      padding: 10px 7%;
      display: flex;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
      font-size: 13px;
    }

    header {
      background: white;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 25px;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 3px 15px #00000010;
    }

    .logo {
      color: var(--azul);
      font-size: 34px;
      font-weight: 800;
      line-height: 1;
    }

    .logo span {
      color: #eeb900;
    }

    .logo small {
      display: block;
      font-size: 10px;
      letter-spacing: 1px;
      margin-top: 5px;
    }

    nav {
      display: flex;
      gap: 25px;
      align-items: center;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--azul);
      font-weight: 600;
      font-size: 14px;
    }

    nav a:hover {
      color: #d9a900;
    }

    .botao {
      display: inline-block;
      background: var(--amarelo);
      color: var(--azul);
      padding: 13px 22px;
      border-radius: 30px;
      font-weight: 800;
      transition: .3s;
      border: none;
    }

    .botao:hover {
      background: white;
      transform: translateY(-3px);
      box-shadow: 0 7px 20px #00000020;
    }

    .hero {
      min-height: 570px;
      display: flex;
      align-items: center;
      padding: 70px 7%;
      background:
        linear-gradient(90deg, #061a36 0%, #061a36e8 38%, #061a3640 100%),
        url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1800&q=85')
        center/cover;
      color: white;
    }

    .hero-conteudo {
      max-width: 650px;
      animation: subir 1s ease;
    }

    .etiqueta {
      display: inline-block;
      color: var(--amarelo);
      border: 1px solid #ffcc2270;
      background: #ffcc2215;
      padding: 7px 14px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(38px, 5vw, 65px);
      line-height: 1.1;
      margin-bottom: 22px;
    }

    h1 span {
      color: var(--amarelo);
    }

    .hero p {
      color: #e1e8f2;
      font-size: 17px;
      max-width: 510px;
      margin-bottom: 30px;
    }

    .botoes {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .botao-contorno {
      border: 1px solid #ffffff80;
      color: white;
      padding: 12px 22px;
      border-radius: 30px;
      font-weight: 600;
    }

    section {
      padding: 80px 7%;
    }

    .titulo {
      text-align: center;
      max-width: 650px;
      margin: 0 auto 45px;
    }

    .titulo span {
      color: #bd9200;
      font-weight: 800;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 2px;
    }

    .titulo h2 {
      color: var(--azul);
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.2;
      margin: 10px 0;
    }

    .titulo p {
      color: #68758a;
    }

    .servicos {
      background: var(--cinza);
    }

    .grade {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .card {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 5px 25px #071d3b0c;
      transition: .3s;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 35px #071d3b18;
    }

    .card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      display: block;
    }

    .card-conteudo {
      padding: 24px;
    }

    .numero {
      display: inline-grid;
      place-items: center;
      background: var(--amarelo);
      color: var(--azul);
      width: 38px;
      height: 38px;
      border-radius: 12px;
      font-weight: 800;
      margin-bottom: 15px;
    }

    .card h3 {
      color: var(--azul);
      font-size: 18px;
      margin-bottom: 10px;
    }

    .card p {
      font-size: 14px;
      color: #68758a;
    }

    .sobre {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 60px;
    }

    .sobre img {
      width: 100%;
      height: 430px;
      object-fit: cover;
      border-radius: 24px;
      box-shadow: 15px 15px 0 var(--amarelo);
    }

    .sobre h2 {
      color: var(--azul);
      font-size: clamp(30px, 4vw, 42px);
      line-height: 1.2;
      margin: 12px 0 20px;
    }

    .sobre p {
      color: #647187;
      margin-bottom: 20px;
    }

    .vantagem {
      list-style: none;
      margin: 22px 0 28px;
    }

    .vantagem li {
      margin: 12px 0;
      font-weight: 600;
    }

    .vantagem li::before {
      content: "✓";
      color: #bd9200;
      background: #fff4c7;
      padding: 3px 8px;
      border-radius: 50%;
      margin-right: 10px;
    }

    .faixa {
      background: var(--azul);
      color: white;
      text-align: center;
      padding: 65px 7%;
    }

    .faixa h2 {
      font-size: clamp(28px, 4vw, 42px);
      margin-bottom: 12px;
    }

    .faixa h2 span {
      color: var(--amarelo);
    }

    .faixa p {
      color: #d3deee;
      margin-bottom: 25px;
    }

    .contato {
      background: var(--cinza);
    }

    .contato-grade {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .contato-card {
      background: white;
      padding: 28px;
      border-radius: 16px;
      text-align: center;
      box-shadow: 0 5px 25px #071d3b0a;
    }

    .contato-card .icone {
      font-size: 30px;
      margin-bottom: 12px;
    }

    .contato-card h3 {
      color: var(--azul);
      margin-bottom: 8px;
    }

    .contato-card p {
      color: #68758a;
      font-size: 14px;
    }

    footer {
      background: #04152c;
      color: white;
      padding: 35px 7%;
      text-align: center;
    }

    footer .logo {
      color: white;
      margin-bottom: 18px;
    }

    footer p {
      color: #c4cede;
      font-size: 13px;
      margin-top: 12px;
    }

    .whatsapp-flutuante {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 20;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #20c866;
      color: white;
      display: grid;
      place-items: center;
      font-size: 29px;
      box-shadow: 0 5px 20px #0003;
    }

    @keyframes subir {
      from { opacity: 0; transform: translateY(25px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 950px) {
      header {
        flex-direction: column;
      }

      nav {
        justify-content: center;
        gap: 15px;
      }

      .grade {
        grid-template-columns: repeat(2, 1fr);
      }

      .sobre {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .sobre img {
        height: 340px;
      }
    }

    @media (max-width: 600px) {
      .topo {
        justify-content: center;
        text-align: center;
      }

      header {
        padding: 20px 5%;
      }

      nav {
        gap: 12px;
      }

      nav a {
        font-size: 12px;
      }

      .hero {
        min-height: 530px;
        padding: 55px 6%;
        background-position: 58% center;
      }

      .hero p {
        font-size: 15px;
      }

      section {
        padding: 60px 6%;
      }

      .grade,
      .contato-grade {
        grid-template-columns: 1fr;
      }

      .card img {
        height: 220px;
      }

      .sobre img {
        height: 280px;
      }
    }
  </style>
</head>

